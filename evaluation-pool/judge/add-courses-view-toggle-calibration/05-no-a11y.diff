+<script>
+  // Obsługa przełącznika widoku: klik ustawia data-view na kontenerze
+  // (prezentacją steruje wyłącznie CSS), zapisuje wybór w localStorage
+  // i aktualizuje aria-pressed. Stan początkowy aria synchronizuje się
+  // z widokiem zaaplikowanym przed malowaniem przez skrypt inline wyżej.
+  const root = document.querySelector<HTMLElement>('[data-course-list-root]');
+  const options = Array.from(
+    document.querySelectorAll<HTMLElement>('[data-course-view-option]')
+  );
+
+  function applyView(view: string): void {
+    if (!root) return;
+    root.dataset.view = view;
+  }
+
+  if (root) {
+    applyView(root.dataset.view === 'list' ? 'list' : 'grid');
+    for (const option of options) {
+      option.addEventListener('click', () => {
+        const view = option.dataset.courseViewOption === 'list' ? 'list' : 'grid';
+        applyView(view);
+        try {
+          localStorage.setItem('courses:view', view);
+        } catch {
+          /* brak localStorage — widok działa, tylko nie przetrwa odświeżenia */
+        }
+      });
+    }
+  }
+</script>
