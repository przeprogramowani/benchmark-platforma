+import { MISSION_LOG_LESSON_CATALOG, type MissionLogModuleId } from './lessonCatalog';
+
+export type { ParticipationBadgeResponse } from '@/server/badges/badgesApiClient';
+import type { ParticipationBadgeResponse } from '@/server/badges/badgesApiClient';
+
+/** Ile razy jedna lekcja może wygenerować odznakę. */
+export const MAX_GENERATIONS_PER_LESSON = 2;
+
+/** Liczba odznak Mission Log — pochodna katalogu lekcji, nigdy literał. */
+export const TOTAL_MISSION_LOG_BADGES = MISSION_LOG_LESSON_CATALOG.length;
+
+/**
+ * Kody błędów emitowane przez Mission Log API — verbatim, dokładnie tak,
+ * jak trafiają na drut. Niekonsekwencje nazewnicze ('Unauthorized' vs
+ * 'quota_exhausted') są celowe: ujednolicenie byłoby zmianą API.
+ */
+export type MissionLogApiErrorCode =
+  | 'Invalid JSON body'
+  | 'Invalid request body'
+  | 'Unauthorized'
+  | 'Forbidden'
+  | 'ACCESS_UNAVAILABLE'
+  | 'lesson_not_found'
+  | 'avatar_missing'
+  | 'module_locked'
+  | 'quota_exhausted'
+  | 'upstream_busy'
+  | 'upstream_origin_forbidden'
+  | 'upstream_error';
+
+/** Komunikat dla odpowiedzi bez rozpoznanego kodu błędu. */
+export const MISSION_LOG_GENERIC_ERROR_MESSAGE =
+  'Nie udało się wygenerować odznaki. Spróbuj ponownie.';
+
+/**
+ * Polskie komunikaty per kod. Record<kod, string> celowo: nowy kod
+ * w unii bez komunikatu = błąd kompilacji.
+ */
+export const MISSION_LOG_ERROR_MESSAGES: Record<MissionLogApiErrorCode, string> = {
+  'Invalid JSON body': MISSION_LOG_GENERIC_ERROR_MESSAGE,
+  'Invalid request body': MISSION_LOG_GENERIC_ERROR_MESSAGE,
+  Unauthorized: 'Sesja wygasła. Zaloguj się ponownie.',
+  Forbidden: 'Brak dostępu do 10xDevs 3.0.',
+  ACCESS_UNAVAILABLE: MISSION_LOG_GENERIC_ERROR_MESSAGE,
+  lesson_not_found: MISSION_LOG_GENERIC_ERROR_MESSAGE,
+  avatar_missing: MISSION_LOG_GENERIC_ERROR_MESSAGE,
+  module_locked: 'Moduł jest jeszcze zablokowany.',
+  quota_exhausted: 'Limit wykorzystany.',
+  upstream_busy: 'Spróbuj za chwilę — generator jest chwilowo zajęty.',
+  upstream_origin_forbidden: MISSION_LOG_GENERIC_ERROR_MESSAGE,
+  upstream_error: MISSION_LOG_GENERIC_ERROR_MESSAGE,
+};
+
+/** Etykiety modułów — przeniesione z komponentu, żeby wszystko było w jednym miejscu. */
+export const MISSION_LOG_MODULE_LABELS: Record<MissionLogModuleId, string> = {
+  m1: 'Moduł 1',
+  m2: 'Moduł 2',
+  m3: 'Moduł 3',
+  m4: 'Moduł 4',
+  m5: 'Moduł 5',
+};
+
+export interface GenerateBadgeSuccessResponse {
+  badgeImageUrl: string;
+  count: number;
+  remaining: number;
+}
+
+export interface MissionLogErrorResponse {
+  error: MissionLogApiErrorCode;
+  unlocksAt?: string | null;
+}
+
+export interface ParticipationBadgeSuccessResponse {
+  badge: ParticipationBadgeResponse | null;
+}
