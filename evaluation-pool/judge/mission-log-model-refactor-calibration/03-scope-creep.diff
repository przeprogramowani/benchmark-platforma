diff --git a/apps/edu-platform/src/server/missionLog/http.ts b/apps/edu-platform/src/server/missionLog/http.ts
new file mode 100644
index 00000000..8895500c
--- /dev/null
+++ b/apps/edu-platform/src/server/missionLog/http.ts
@@ -0,0 +1,29 @@
+import type {
+  GenerateBadgeSuccessResponse,
+  MissionLogApiErrorCode,
+  ParticipationBadgeSuccessResponse,
+} from '@/models/missionLog/contract';
+
+const jsonHeaders = { 'Content-Type': 'application/json' };
+
+/**
+ * Odpowiedź błędu Mission Log API. Kod jest typowany kontraktem —
+ * literówka albo kod spoza unii nie skompiluje się.
+ */
+export function jsonError(
+  code: MissionLogApiErrorCode,
+  status: number,
+  extra?: Record<string, unknown>,
+): Response {
+  return new Response(JSON.stringify({ error: code, ...extra }), {
+    status,
+    headers: jsonHeaders,
+  });
+}
+
+/** Odpowiedź sukcesu — kształt pilnowany typami odpowiedzi z kontraktu. */
+export function jsonOk(
+  body: GenerateBadgeSuccessResponse | ParticipationBadgeSuccessResponse,
+): Response {
+  return new Response(JSON.stringify(body), { status: 200, headers: jsonHeaders });
+}
