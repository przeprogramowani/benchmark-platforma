@@ -0,0 +1,29 @@
+import { describe, expect, it } from 'vitest';
+import { MISSION_LOG_LESSON_CATALOG } from './lessonCatalog';
+import {
+  MAX_GENERATIONS_PER_LESSON,
+  MISSION_LOG_ERROR_MESSAGES,
+  MISSION_LOG_GENERIC_ERROR_MESSAGE,
+  TOTAL_MISSION_LOG_BADGES,
+} from './contract';
+
+describe('mission log contract', () => {
+  it('TOTAL_MISSION_LOG_BADGES follows the lesson catalog', () => {
+    expect(TOTAL_MISSION_LOG_BADGES).toBe(MISSION_LOG_LESSON_CATALOG.length);
+  });
+
+  it('exposes the per-lesson generation limit', () => {
+    expect(MAX_GENERATIONS_PER_LESSON).toBeGreaterThan(0);
+  });
+
+  it('every error code has a non-empty message', () => {
+    for (const [code, message] of Object.entries(MISSION_LOG_ERROR_MESSAGES)) {
+      expect(message, `missing message for ${code}`).toBeTruthy();
+      expect(message.trim().length, `blank message for ${code}`).toBeGreaterThan(0);
+    }
+  });
+
+  it('has a generic fallback message', () => {
+    expect(MISSION_LOG_GENERIC_ERROR_MESSAGE.trim().length).toBeGreaterThan(0);
+  });
+});
